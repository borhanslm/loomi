                        },
                        "createdAt": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "lastSeen": {
                          "format": "date-time",
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
