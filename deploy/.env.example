# Your server's domain (point its DNS A record to this server first)
LOOMI_DOMAIN=loomi.example.com
# Long random password for the database:      openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# 32-byte key that encrypts users' API keys:   openssl rand -hex 32
# Keep a safe copy: without it, saved API keys cannot be decrypted.
LOOMI_MASTER_KEY=
# Only for docker-compose.tunnel.yml: the token from Cloudflare (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
